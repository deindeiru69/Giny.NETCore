@using Giny.Core.IO.Configuration;
@using Giny.Zaap.Accounts;
@using Microsoft.AspNetCore.Components.Web;
@using MudBlazor;
<div class="d-flex align-center justify-center pa-13">

    <div class="container pa-4" style="gap:0px;align-items:center;width:380px">
        <MudImage Width=300 Height=300 Class="pa-2" Fluid=true ObjectFit=ObjectFit.Cover ObjectPosition=ObjectPosition.Center
                  Src="https://i.imgur.com/vjCw7cz.png"></MudImage>


        <div class="d-flex flex-column  gap-1;">

            <MudTextField Immediate=true Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.AccountCircle" Variant=Variant.Filled Label="Nom de compte" @bind-Value="Login"></MudTextField>


            <MudTextField Immediate=true Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Password" Variant=Variant.Filled InputType=InputType.Password Label="Mot de passe" @bind-Value="Password"></MudTextField>
            <MudTextField Immediate=true OnKeyDown="OnKeyDown" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Password" Variant=Variant.Filled InputType=InputType.Password Label="Confirmation mot de passe" @bind-Value="PasswordConf"></MudTextField>

            <div class="d-flex flex-column gap-3 my-2">
                <MudButton OnClick="Register" Variant="Variant.Filled" Color="Color.Primary" Disabled="Processing">

                    @if (Processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.AppRegistration"></MudIcon>
                    }
                    <MudText Class="ms-2">Inscription</MudText>


                </MudButton>

                <MudButton OnClick="BackToLogin" StartIcon="@Icons.Material.Outlined.ArrowBack" Variant="Variant.Text" Color="Color.Primary">
                    Retour au login
                </MudButton>

            </div>

        </div>



    </div>

    <div></div>
</div>
@inject IDialogService DialogService;
@inject ISnackbar Snackbar;

@code {
    [Parameter]
    public MainLayout Parent
    {
        get;
        set;
    }
    string Login
    {
        get;
        set;
    }
    string Password
    {
        get;
        set;
    }
    string PasswordConf
    {

        get;
        set;
    }

    private bool Processing
    {
        get;
        set;
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Code == "Enter")
        {
            Register();
        }
    }

    void BackToLogin()
    {
        Parent.Navigate(PageEnum.Login);
    }

    async void Register()
    {
        // Validations côté UI — fast-fail avant le HTTP round-trip.
        if (string.IsNullOrWhiteSpace(Login) || Login.Length < 3)
        {
            DialogHelper.OpenDialog(DialogService, "Erreur", "Nom de compte trop court (3 caractères minimum).");
            return;
        }

        if (string.IsNullOrEmpty(Password) || Password.Length < 4)
        {
            DialogHelper.OpenDialog(DialogService, "Erreur", "Mot de passe trop court (4 caractères minimum).");
            return;
        }

        if (Password != PasswordConf)
        {
            DialogHelper.OpenDialog(DialogService, "Erreur", "Les mots de passe ne correspondent pas.");
            return;
        }

        Processing = true;
        StateHasChanged();

        RegisterResponse result;
        try
        {
            result = await AuthApi.Register(Login, Password);
        }
        catch (Exception ex)
        {
            DialogHelper.OpenDialog(DialogService, "Erreur", $"Impossible de joindre le serveur : {ex.Message}");
            Processing = false;
            StateHasChanged();
            return;
        }

        Processing = false;

        if (result.Success && result.Account != null)
        {
            // Stocke le compte créé localement et revient au login.
            var config = ConfigManager<UplConfig>.Instance;
            config.Accounts.Add(result.Account);
            ConfigManager<UplConfig>.Save(UplConfig.Filepath);

            Snackbar.Add("Compte créé avec succès.", Severity.Success);
            Parent.UpdateState();
            Parent.Navigate(PageEnum.Login);
        }
        else
        {
            DialogHelper.OpenDialog(DialogService, "Erreur",
                string.IsNullOrEmpty(result.Message) ? "Création de compte refusée." : result.Message);
            StateHasChanged();
        }
    }

}
