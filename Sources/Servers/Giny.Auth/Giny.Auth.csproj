<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>giny.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="giny.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="config.Production.example.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template documentaire de la config de production (overlay appliqué
         quand DOTNET_ENVIRONMENT=Production). À copier en config.Production.json
         sur la VM puis renseigner. config.Production.json n'est jamais versionné. -->
    <Content Include="config.Production.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Giny.Core\Giny.Core.csproj" />
    <ProjectReference Include="..\..\Giny.IO\Giny.IO.csproj" />
    <ProjectReference Include="..\..\Giny.ORM\Giny.ORM.csproj" />
    <ProjectReference Include="..\..\Giny.Protocol\Giny.Protocol.csproj" />
  </ItemGroup>

</Project>
