<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>world.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="appsettings.Development.json" />
	  <None Remove="appsettings.json" />
	  <None Remove="config.Production.example.json" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="appsettings.Development.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <!-- Template documentaire de la config de production (overlay appliqué
	       quand DOTNET_ENVIRONMENT=Production). À copier en config.Production.json
	       sur la VM puis renseigner. config.Production.json n'est jamais versionné. -->
	  <Content Include="config.Production.example.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="world.ico" />
	  <!-- Hero Mode (Phase 5) — RawPatch UI poussé aux clients, recopié dans
	       le dossier SWF/ d'exécution à chaque build. -->
	  <Content Include="..\..\..\Ressources\SWFPatches\HeroPanel\HeroPanel.swf"
	           Link="SWF\HeroPanel.swf"
	           Condition="Exists('..\..\..\Ressources\SWFPatches\HeroPanel\HeroPanel.swf')">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
		<ProjectReference Include="..\..\Giny.Core\Giny.Core.csproj" />
		<ProjectReference Include="..\..\Giny.IO\Giny.IO.csproj" />
		<ProjectReference Include="..\..\Giny.ORM\Giny.ORM.csproj" />
		<ProjectReference Include="..\..\Giny.Protocol\Giny.Protocol.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Managers\Entities\TaxCollectors\" />
	</ItemGroup>

</Project>
