<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config.Production.example.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template de la config de production (overlay appliqué quand
         DOTNET_ENVIRONMENT=Production). À copier en config.Production.json
         sur la VM puis renseigner SQLPassword. Jamais versionné. -->
    <Content Include="config.Production.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Giny.IO\Giny.IO.csproj" />
    <ProjectReference Include="..\..\Giny.ORM\Giny.ORM.csproj" />
    <ProjectReference Include="..\..\Servers\Giny.World\Giny.World.csproj" />
  </ItemGroup>

  <!-- Évite le NETSDK1152 lors du publish : Giny.World.csproj déclare son propre
       config.Production.example.json en <Content CopyToPublishDirectory>, qui
       remonte transitivement et entre en conflit avec celui du Synchronizer (même
       RelativePath). On filtre la copie venant de Giny.World après que la liste
       ResolvedFileToPublish soit complète mais avant la détection de conflits.
       Le local au Synchronizer reste, c'est le source de vérité pour ce CLI. -->
  <Target Name="RemoveTransitiveConfigExample"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'config.Production.example.json' AND $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('Giny.World'))" />
    </ItemGroup>
  </Target>

</Project>
